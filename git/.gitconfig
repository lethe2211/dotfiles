[user]
	name = lethe2211
	email = lethe2211@gmail.com
[core]
	editor = vim
[alias]
	logg = log --graph --stat --pretty=format:'%Cblue%h %Cgreen%ar %Cred%an %Creset%s'
[push]
	default = simple
[alias]
	br = branch
	co = checkout
	cob = checkout -b
	ci = commit
	cm = commit -m
	d = diff
	dc = diff --cached
	mg = merge
	
[color]
	ui = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[init]
	defaultBranch = main
